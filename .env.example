# Configuration mywhoosh-sync pour Dreeve
# Copiez ce fichier en .env dans ce dossier ou définissez ces variables dans l'environnement

# Identifiants MyWhoosh (requis)
# Utilisez l'email et le mot de passe de votre compte MyWhoosh
# Si votre compte a été créé via Google/Apple, définissez d'abord un mot de passe dans MyWhoosh
MYWHOOSH_USERNAME=votre-email@exemple.fr
MYWHOOSH_PASSWORD=votre-mot-de-passe

# Token d'accès (optionnel, utilisé si déjà sauvegardé)
# MYWHOOSH_ACCESS_TOKEN=

# Nombre de pages à parcourir (0 = toutes). Défaut: 0
# Limitez à un petit nombre pour un premier test
MYWHOOSH_MAX_PAGES=0

# Fréquence de synchronisation en secondes. Défaut: 900
MYWHOOSH_SYNC_INTERVAL_SECONDS=900

# Dossier de dépôt (monté par défaut vers /watch dans Docker)
WATCH_DIR=/watch

# Dossier d'état local (monté par défaut vers /state dans Docker)
STATE_DIR=/state

# Chemin vers la base Dreeve (lecture seule) pour éviter les doublons
# Recommandé : monter ./storage/database dans le conteneur en lecture seule
DREEVE_DB=/db/strava.db

# Activités à exclure définitivement (activityFileId séparés par des virgules)
# Utile pour éviter de réimporter une activité problématique
MYWHOOSH_IGNORED_ACTIVITY_FILE_IDS=
